# Server
PORT=5000
NODE_ENV=development

# Database (required in production)
MONGO_URI=mongodb://127.0.0.1:27017/srkr_coding_club

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Admin account (created on first startup if not exists)
ADMIN_EMAIL=admin@srkrec.edu.in
ADMIN_PASSWORD=change-this-admin-password

# Email (SMTP) — required for OTP and notifications
# Gmail example: use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SRKR Coding Club" <your-email@gmail.com>

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# Cloudinary (optional — resumes stored locally if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
